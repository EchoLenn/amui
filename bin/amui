VERSION = "0.4.0"
SEP = "\x1f"
THEMES = {
    "nocturne": (234, 255, 244, 239, 211, 80, 183),
    "ember": (234, 230, 244, 239, 209, 222, 173),
    "ice": (234, 255, 244, 239, 81, 153, 111),
}
THEMES.update({name: tuple(parse_color(c) for c in colors.split()) for name, colors in {
    "sakura": "#1e1b2e #f8e8ee #aaa0b8 #756580 #e8a0bf #bca5ee #f1c9ae",
